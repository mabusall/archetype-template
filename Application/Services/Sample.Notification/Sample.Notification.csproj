<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Views\**" Exclude="bin\**;obj\**;**\*.xproj;packages\**;@(EmbeddedResource)" />
		<PackageReference Include="FirebaseAdmin" Version="3.6.0" />
		<ProjectReference Include="..\..\..\Shared\Archetype.Infrastructure\Archetype.Infrastructure.csproj" />
		<ProjectReference Include="..\..\..\Shared\Archetype.Resources\Archetype.Resources.csproj" />
		<Content Update="Views\**\*.cshtml" />
	</ItemGroup>

</Project>
