{
  "AllowedHosts": "*",

  // Enable detailed logging for troubleshooting APM and database spans
  "Logging": {
    "LogLevel": {
      "Default": "Information",

      // Entity Framework Core - shows SQL queries being executed
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",

      // MassTransit - shows message bus activity
      "MassTransit": "Information",

      // Reduce noise from other Microsoft components
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  }
}
